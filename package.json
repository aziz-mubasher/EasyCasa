{
  "name": "easycasa",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm --filter @easycasa/shared build && pnpm -r --if-present typecheck",
    "test": "pnpm --filter @easycasa/shared build && pnpm -r --if-present test",
    "check:omi-copy": "bash scripts/check-omi-price-copy.sh",
    "check:seller-inbox-copy": "bash scripts/check-seller-inbox-copy.sh",
    "check:seller-analytics-copy": "bash scripts/check-seller-analytics-copy.sh",
    "check:seller-hardcoded-strings": "bash scripts/check-seller-hardcoded-strings.sh",
    "check:json-ld-escape": "bash scripts/check-json-ld-escape.sh",
    "check:counsel-copy": "pnpm check:omi-copy && pnpm check:seller-inbox-copy && pnpm check:seller-analytics-copy && pnpm check:seller-hardcoded-strings && pnpm check:json-ld-escape",
    "azm:bridge-status": "node scripts/azm-bridge-status.mjs",
    "azm:bridge-status:validate": "node scripts/azm-bridge-status.mjs validate",
    "build": "pnpm --filter @easycasa/shared build && pnpm -r --if-present build",
    "format": "prettier --write .",
    "demo:seed": "pnpm --filter @easycasa/api demo:seed",
    "demo:reset": "pnpm --filter @easycasa/api demo:reset"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.19",
      "vitest": "^3.2.6",
      "multer": ">=2.1.1",
      "undici": ">=6.24.0",
      "lodash": ">=4.18.0",
      "js-yaml": ">=4.3.0",
      "@xmldom/xmldom": ">=0.8.13"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-23864"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@next/eslint-plugin-next": "15.5.21",
    "eslint": "^9.13.0",
    "eslint-config-next": "15.5.21",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  }
}
