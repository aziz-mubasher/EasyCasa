# Copy to repo-root `.env.demo` (git-ignored). Never point at production secrets/volumes.

DEMO_DOMAIN=demo.easycasaita.com
STAGING_DOMAIN=demo.easycasaita.com

POSTGRES_USER=easycasa_demo
POSTGRES_PASSWORD=change_me_demo_db
POSTGRES_DB=easycasa_demo
DATABASE_URL=postgresql://easycasa_demo:change_me_demo_db@db:5432/easycasa_demo

REDIS_URL=redis://redis:6379
MEILI_MASTER_KEY=change_me_demo_meili
MEILI_URL=http://meilisearch:7700

MINIO_ROOT_USER=easycasa_demo
MINIO_ROOT_PASSWORD=change_me_demo_minio
MINIO_BUCKET=easycasa-demo-media
S3_ENDPOINT=http://minio:9000
MEDIA_ORIGIN=minio
MEDIA_PUBLIC_BASE=http://minio:9000/easycasa-demo-media

DEMO_MODE=true
ALLOW_PROVIDER_STUBS=true
# Leave SMTP / Brevo / WhatsApp / Banks4All empty — compose also blanks them.
# SMTP_URL=
# EMAIL_PROVIDER_URL=
NOTIFY_FROM=EasyCasa Demo <no-reply@demo.easycasaita.com>
# BANKS4ALL_ATTESTATION_BASE_URL=
# BANKS4ALL_PARTNER_TOKEN=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

PAYMENTS_ENABLED=true
GO_LIVE_PAYMENTS_ACK=false
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_PAYMENTS_ENABLED=true
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SITE_URL=https://demo.easycasaita.com
NEXT_PUBLIC_API_URL=https://demo.easycasaita.com/api
API_URL=http://api:4000
VITE_API_BASE_URL=https://demo.easycasaita.com/api

VALUATION_BAND_ENABLED=true
NEXT_PUBLIC_VALUATION_BAND_ENABLED=true

CORS_ORIGINS=https://demo.easycasaita.com,https://admin.demo.easycasaita.com,http://localhost:3000

# Optional basic auth at Traefik (recommended when sharing links) — configure separately.
# OIDC: leave blank + ALLOW_PROVIDER_STUBS for local demo; wire demo realm later if needed.
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_URL=
# NEXT_PUBLIC_OIDC_ISSUER=
NEXT_PUBLIC_OIDC_CLIENT_ID=easycasa-web
