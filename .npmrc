# Expo + React Native need these reachable from the app root under pnpm.
# Without hoisting, EAS "Bundle React Native code and images" fails resolving
# packages like @react-native/assets-registry (and previously expo-asset).
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*expo-*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=@react-native/*
public-hoist-pattern[]=*react-navigation*
public-hoist-pattern[]=@react-navigation/*
