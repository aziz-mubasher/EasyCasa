# ---------- Domains ----------
# Set to your staging domain for the VPS (Caddy issues TLS automatically).
# Use "localhost" for local development.
# Public brand / hostname (Easy Casa Ita). Compose project name is easycasa-ita.
STAGING_DOMAIN=easycasaita.com

# ---------- Postgres ----------
POSTGRES_USER=easycasa
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=easycasa
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://easycasa:change_me_strong@db:5432/easycasa

# ---------- Redis ----------
REDIS_URL=redis://redis:6379

# ---------- Meilisearch ----------
MEILI_MASTER_KEY=change_me_meili_key
MEILI_URL=http://meilisearch:7700

# ---------- MinIO (S3-compatible object storage — local / fallback) ----------
MINIO_ROOT_USER=easycasa
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET=easycasa-media
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1

# ---------- Media / CDN ----------
# minio = on-VPS MinIO (default). bunny = Bunny Storage Zone + Pull Zone CDN.
MEDIA_ORIGIN=minio
# Listing image public URLs. MinIO: API proxy. Bunny: Pull Zone hostname.
MEDIA_PUBLIC_BASE=https://easycasaita.com/api/media/file
# Private users/docs URLs (empty = API proxy when MEDIA_ORIGIN=bunny).
MEDIA_PRIVATE_BASE=

# ---------- Bunny.net (set MEDIA_ORIGIN=bunny after rotating credentials) ----------
# Storage Zone name (= S3 access key id + bucket). Password = Storage Zone Access Key / FTP password.
# Never commit real passwords. Paste only into VPS .env after rotation.
BUNNY_STORAGE_ZONE=easycasaita
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_ENDPOINT=https://de-s3.storage.bunnycdn.com
BUNNY_S3_REGION=de
# Pull Zone custom domain (linked hostnames: cdn.easycasaita.com)
BUNNY_CDN_BASE=https://cdn.easycasaita.com
# Optional: set MEDIA_PUBLIC_BASE=$BUNNY_CDN_BASE when origin=bunny (or leave BUNNY_CDN_BASE set —
# resolveObjectStorage prefers BUNNY_CDN_BASE for listing URLs).

# ---------- App ----------
API_PORT=4000
WEB_PORT=3000
AI_PORT=8000
NODE_ENV=production

# ---------- Backups (restic offsite) ----------
# RESTIC_REPOSITORY=s3:https://s3.example.com/easycasa-backups
# RESTIC_PASSWORD=change_me_restic
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ---------- WordPress source (Phase 1 migration) ----------
WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_USER=root
WP_DB_PASSWORD=change_me_wp
WP_DB_NAME=wordpress
WP_TABLE_PREFIX=wp_
WP_LISTING_POST_TYPE=listing_type
WP_PERMALINK_BASE=
WP_UPLOADS_BASE_URL=https://easycasaita.com/wp-content/uploads

# ---------- Geocoding ----------
GEOCODER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=EasyCasaMigration/1.0 (ops@easycasaita.com)

# ---------- Auth (Phase 2, OIDC) ----------
# Local/CI: ALLOW_PROVIDER_STUBS=true. Tests: NODE_ENV=test + EC_TEST_AUTH=true.
# Production VPS: both false; set OIDC_* for real Keycloak JWTs.
ALLOW_PROVIDER_STUBS=true
EC_TEST_AUTH=true
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLES_CLAIM=realm_access.roles

# EC-12 phone verify (WhatsApp Cloud API; empty token → email OTP fallback)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=easycasa_otp
WHATSAPP_OTP_TEMPLATE_LANG=it
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# EC-17 — ops forward + retention (default 90d — COUNSEL TO CONFIRM)
WHATSAPP_INBOUND_OPS_EMAIL=
WA_INBOUND_RETENTION_DAYS=90
# EC-19 — body-bearing ops email (default off → subject-line alert + admin link only)
WA_INBOUND_EMAIL_FORWARD=false
ADMIN_PUBLIC_URL=https://admin.easycasaita.com
# EC-19a — HMAC secret for opaque wa_handle (min 16). Required at boot. Rotation breaks deep-links only.
WA_HANDLE_SECRET=local-wa-handle-secret-change-me
# Phase C utility templates (empty name → skip that WhatsApp send; email still runs)
WHATSAPP_VIEWING_REMINDER_24H_TEMPLATE=easycasa_viewing_reminder_24h
WHATSAPP_VIEWING_REMINDER_2H_TEMPLATE=easycasa_viewing_reminder_2h
WHATSAPP_VIEWING_REQUESTED_TEMPLATE=easycasa_viewing_requested
WHATSAPP_VIEWING_CONFIRMED_TEMPLATE=easycasa_viewing_confirmed
WHATSAPP_VIEWING_CANCELLED_TEMPLATE=easycasa_viewing_cancelled
WHATSAPP_ENQUIRY_RECEIVED_TEMPLATE=easycasa_enquiry_received
PHONE_OTP_PEPPER=local-phone-otp-pepper-change-me

# ---------- Web (Phase 3) ----------
# Server-side fetches use API_URL (internal); browser uses NEXT_PUBLIC_API_URL.
API_URL=http://api:4000
NEXT_PUBLIC_API_URL=https://easycasaita.com/api
NEXT_PUBLIC_OIDC_ISSUER=
NEXT_PUBLIC_OIDC_CLIENT_ID=easycasa-web
# MapLibre basemap style URL — baked at web image build; rebuild web after changing.
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
# K EC 1.26 — provisional valuation band (stub comparables; enable when ready).
NEXT_PUBLIC_VALUATION_BAND_ENABLED=false
# EC-22 — dark Analisi Aste upload UI (must match API ASTE_ANALYSIS_ENABLED). Default off.
NEXT_PUBLIC_ASTE_ANALYSIS_ENABLED=false
# EC-S Phase 1 — seller onboarding / media / dupdetect (T06–T12)
SELLER_ONBOARDING_ENABLED=false
# Set only after signed T05 Layer 1 (e.g. seller-informativa-v1)
INFORMATIVA_SELLER_VERSION=
MEDIA_CDN_ENABLED=false
IMAGE_DUPDETECT_ENFORCE=false
SELLER_MAX_ACTIVE_LISTINGS=5
SELLER_MAX_UPLOADS_PER_DAY=20
# EC-S Phase 2 — Verified Owner (T14); enable after T05 Layer 1 + §6.3
VERIFIED_OWNER_ENABLED=false
VERIFIED_OWNER_VALIDITY_MONTHS=12
SELLER_CHECKLIST_ENABLED=false
# EC-S Phase 3 — seller enquiry inbox (T20); enable after G1
SELLER_INBOX_ENABLED=false
# EC-S Phase 3 — seller-conducted viewings + open-house capacity (T21/T22)
SELLER_VIEWINGS_ENABLED=false

# K EC 1.38 — show "Proceed to payment" on /pricing (requires API PAYMENTS_ENABLED + Stripe test keys).
NEXT_PUBLIC_PAYMENTS_ENABLED=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------- Valuation band (K EC 1.26) ----------
VALUATION_BAND_ENABLED=false

# ---------- Analisi Aste (EC-22 / EC-23) ----------
ASTE_ANALYSIS_ENABLED=false
# Retention for submitted/failed analyses + MinIO objects (COUNSEL PENDING — LGL-1).
ASTE_DOCS_RETENTION_DAYS=365
# EC-23 — Nest→AI internal calls (compose network). Token required on AI /aste/* routes.
# AI_URL is also used by the web server for search/assistant; API uses it for the pipeline.
AI_INTERNAL_TOKEN=
ASTE_PIPELINE_POLL_MS=10000
ASTE_OCR_TIMEOUT_MS=600000
ASTE_EXTRACT_TIMEOUT_MS=300000
ASTE_EMBED_TIMEOUT_MS=120000
# EC-24 — translate HTTP timeout (ms)
ASTE_TRANSLATE_TIMEOUT_MS=120000
# EC-25 — grounded chat
ASTE_CHAT_TIMEOUT_MS=120000
ASTE_CHAT_Q_PER_ANALYSIS_DAY=20
ASTE_CHAT_Q_PER_USER_DAY=60
ASTE_PIPELINE_MAX_ATTEMPTS=2
ASTE_PIPELINE_STALE_MS=1800000

# ---------- Internal CRM (K EC 4.1) ----------
# Default false for local/CI/demo. §1.6 Q2a consent applied 2026-08-02 —
# set true in production .env to process CRM personal data.
# See docs/legal/crm-controller-responsibility.md
CRM_ENABLED=false
# Dormant seeker anonymisation window (months). Confirmed default: 24.
CRM_DORMANT_RETENTION_MONTHS=24

# ---------- SmartLink view tracking (K EC 1.29) ----------
# Pepper for daily unique-view hashes — rotate in production; never log client visitor ids.
SHARE_VIEW_HMAC_SECRET=change-me-smartlink-view-secret-min-16-chars
AGENCY_PUBLIC_NAME=Easy Casa Italy
AGENCY_PUBLIC_EMAIL=info@easycasaita.com
AGENCY_PUBLIC_PHONE=

# ---------- AI service (Phase 4) ----------
# Embeddings: hashing (offline default) | openai | local
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# Chat/LLM for the assistant: none (templated fallback) | openai
CHAT_PROVIDER=none
CHAT_MODEL=gpt-4o-mini
USE_LLM_NLQ=false
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AI_RATE_LIMIT_PER_MIN=30
# EC-23 — Nest→AI internal token for /aste/* (also set on AI service).
AI_INTERNAL_TOKEN=
AI_URL=http://ai:8000
NEXT_PUBLIC_AI_URL=https://easycasaita.com/ai

# ---------- Billing / notifications (Phase 5) ----------
# Leave STRIPE_* empty until keys are set — checkout returns "billing not configured".
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# K EC 1.38 — order payments (fixed-fee catalog). Default false; use sk_test_* only until go-live ack.
PAYMENTS_ENABLED=false
GO_LIVE_PAYMENTS_ACK=false
PAYMENTS_SUCCESS_URL=https://easycasaita.com/it/pagamento/successo
PAYMENTS_CANCEL_URL=https://easycasaita.com/it/pagamento/annullato
BILLING_SUCCESS_URL=https://easycasaita.com/it/account?billing=success
BILLING_CANCEL_URL=https://easycasaita.com/it/account?billing=cancel
CURRENCY=eur
SMTP_URL=
NOTIFY_FROM=EasyCasa <no-reply@easycasaita.com>
# Phase 36 EmailModule: SMTP_URL or EMAIL_PROVIDER_URL; neither → fail-soft noop
CORS_ORIGINS=https://easycasaita.com,https://www.easycasaita.com,https://app.easycasaita.com,http://localhost:3000,http://localhost:8081

# ---------- Phase 6 — site / observability ----------
NEXT_PUBLIC_SITE_URL=https://easycasaita.com
ACME_EMAIL=ops@easycasaita.com
# Optional observability overlay (infra/observability/docker-compose.observability.yml)
# GRAFANA_ADMIN_PASSWORD=
# PG_EXPORTER_DSN=postgresql://easycasa:change_me_strong@db:5432/easycasa?sslmode=disable

# ---------- Phase 7 — universal app (see apps/mobile/.env.example) ----------
# EXPO_PUBLIC_API_BASE_URL=https://easycasaita.com/api
# EXPO_PUBLIC_OIDC_ISSUER=https://auth.easycasaita.com/realms/easycasa
# EXPO_PUBLIC_OIDC_CLIENT_ID=easycasa-app
# EXPO_PUBLIC_WEB_APP_URL=https://app.easycasaita.com

# ---------- Phase 10 — e-signature (FEA / SPID-CIE) ----------
SIGNATURE_PROVIDER_URL=
SIGNATURE_PROVIDER_KEY=
SIGNATURE_WEBHOOK_SECRET=

# ---------- Phase 12 — RLI channel + AML screening ----------
# Empty + ALLOW_PROVIDER_STUBS=true
EC_TEST_AUTH=true → stub protocollo / clean screen (dev only).
RLI_CHANNEL_URL=
RLI_CHANNEL_CREDENTIAL=
AML_SCREENING_URL=
AML_SCREENING_KEY=

# ---------- Phase 17 — order payments + fattura elettronica ----------
# Empty + ALLOW_PROVIDER_STUBS=true
EC_TEST_AUTH=true → stub PSP client secret / SdI protocollo.
PSP_API_URL=
PSP_SECRET_KEY=
SDI_CHANNEL_URL=
SDI_CHANNEL_KEY=
EASYCASA_PIVA=IT00000000000
EASYCASA_DENOMINAZIONE=Easy Casa Ita Srl

# ---------- Phase 22 / 30 — push / email provider seams ----------
# Empty → console / SMTP_URL fallbacks (fail soft).
PUSH_PROVIDER_URL=
EMAIL_PROVIDER_URL=

# ---------- Phase 38 — GDPR retention ----------
# Unconverted enquiry leads anonymized after N days (default 90).
RETENTION_LEAD_DAYS=90

# ---------- EC-1 — Banks4All B4A-1 partner attestation ----------
# Empty base URL or token → verify fails soft (enquiry still submits, no badge).
# BANKS4ALL_ATTESTATION_BASE_URL=https://portal.banks4all.eu
# BANKS4ALL_PARTNER_TOKEN=

# ---------- Phase 39 — observability / error tracking ----------
# Empty → fail-soft noop reporter (logs only). Set to enable Sentry.
SENTRY_DSN=
# PUSHGATEWAY_URL=http://pushgateway:9091
# CRITICAL_TABLES=listings enquiries viewings users consent_records

# ---------- Phase 13 — admin console (Vite SPA) ----------
# Bake OIDC into the admin image. Do not invent a client-side auth bypass.
VITE_API_BASE_URL=https://easycasaita.com/api
VITE_ALLOW_PROVIDER_STUBS=true
# VITE_OIDC_ISSUER=https://auth.easycasaita.com/realms/easycasa
# VITE_OIDC_CLIENT_ID=easycasa-admin

# ---------- Phase 30 — Keycloak (local: make keycloak; VPS: docker-compose keycloak service) ----------
# KEYCLOAK_HOSTNAME=auth.easycasaita.com
# KEYCLOAK_ADMIN=
# KEYCLOAK_ADMIN_PASSWORD=
# KEYCLOAK_DB=keycloak
